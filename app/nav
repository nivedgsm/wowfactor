
/* 
/* =========================================================
   NAV
========================================================= */

.nav-wrap {
  position: relative;
  z-index: 1000;

  width: 100%;

  background: #f5f3f0;
}

.nav {
  position: relative;
  z-index: 1002;

  width: 100%;
  height: 82px;

  padding: 0 clamp(20px, 5vw, 70px);

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  border-bottom: 1px solid rgba(17, 17, 17, 0.1);
}


/* =========================================================
   BRAND
========================================================= */

.brand {
  display: flex;
  align-items: center;

  width: fit-content;

  text-decoration: none;
}

.brand img {
  display: block;

  width: clamp(105px, 8vw, 135px);
  height: auto;
}


/* =========================================================
   LINKS
========================================================= */

.nav-links {
  display: flex;
  align-items: center;

  gap: clamp(22px, 2.5vw, 38px);
}

.nav-links a,
.nav-treatment-trigger {
  position: relative;

  display: inline-flex;
  align-items: center;

  padding: 5px 0;

  border: 0;
  background: transparent;

  color: #242220;

  font-family: 'Albra', serif;
  font-size: 10px;
  letter-spacing: 0.08em;

  text-decoration: none;

  cursor: pointer;

  transition: color 0.3s ease;
}

.nav-links a::after,
.nav-treatment-trigger::after {
  content: '';

  position: absolute;

  left: 0;
  bottom: 0;

  width: 0;
  height: 1px;

  background: #9b003f;

  transition:
    width 0.4s cubic-bezier(.22,1,.36,1);
}

.nav-links a:hover,
.nav-treatment-trigger:hover,
.nav-treatment-trigger.active {
  color: #9b003f;
}

.nav-links a:hover::after,
.nav-treatment-trigger:hover::after,
.nav-treatment-trigger.active::after {
  width: 100%;
}


/* =========================================================
   TREATMENT ICON
========================================================= */

.nav-trigger-icon {
  position: relative;

  width: 9px;
  height: 9px;

  margin-left: 8px;
}

.nav-trigger-icon span {
  position: absolute;

  left: 0;
  top: 4px;

  width: 9px;
  height: 1px;

  background: currentColor;

  transition:
    transform .4s cubic-bezier(.22,1,.36,1);
}

.nav-trigger-icon span:last-child {
  transform: rotate(90deg);
}

.nav-treatment-trigger.active
.nav-trigger-icon span:last-child {
  transform: rotate(0deg);
}


/* =========================================================
   BOOK BUTTON
========================================================= */

.nav-book {
  justify-self: end;

  display: inline-flex;
  align-items: center;
  gap: 14px;

  min-height: 42px;

  padding: 0 19px;

  border: 1px solid #111;
  border-radius: 999px;

  background: #111;
  color: #fff;

  font-family: 'Albra', serif;
  font-size: 9px;
  letter-spacing: .11em;
  text-transform: uppercase;

  cursor: pointer;

  transition:
    background .35s ease,
    border-color .35s ease;
}

.nav-book-arrow {
  display: flex;

  width: 15px;
  height: 15px;

  transition:
    transform .45s cubic-bezier(.22,1,.36,1);
}

.nav-book-arrow .arrow {
  width: 15px;
  height: 15px;
}

.nav-book:hover {
  background: #9b003f;
  border-color: #9b003f;
}

.nav-book:hover .nav-book-arrow {
  transform: translate(3px,-3px);
}


/* =========================================================
   TREATMENT OVERLAY
========================================================= */

.treatment-overlay {
  position: absolute;

  left: 0;
  right: 0;
  top: 82px;

  z-index: 1001;

  background: #111;

  color: #fff;

  border-top: 1px solid rgba(255,255,255,.08);

  box-shadow:
    0 30px 80px rgba(0,0,0,.16);
}

.treatment-overlay-inner {
  width: 100%;
  max-width: 1500px;

  margin: 0 auto;

  padding:
    clamp(45px,5vw,70px)
    clamp(20px,5vw,70px)
    clamp(50px,6vw,80px);

  display: grid;

  grid-template-columns:
    .75fr
    1.25fr;

  gap: clamp(50px,8vw,120px);
}


/* =========================================================
   OVERLAY INTRO
========================================================= */

.treatment-overlay-intro {
  display: flex;
  flex-direction: column;

  min-width: 0;
}

.overlay-meta {
  display: flex;
  justify-content: space-between;

  padding-bottom: 20px;

  border-bottom: 1px solid rgba(255,255,255,.13);

  font-family: 'Albra', serif;
  font-size: 8px;
  letter-spacing: .18em;

  color: rgba(255,255,255,.32);
}

.overlay-meta span:first-child {
  color: #c99aaa;
}

.overlay-heading {
  margin-top: 45px;
}

.overlay-heading > span {
  display: block;

  margin-bottom: 10px;

  font-family: 'Albra', serif;
  font-size: 9px;
  letter-spacing: .16em;

  color: #c99aaa;
}

.overlay-heading h2 {
  margin: 0;

  font-family: 'Albra', serif;
  font-size: clamp(52px,5.5vw,82px);
  font-weight: 400;
  line-height: .84;
  letter-spacing: -.065em;
}

.overlay-heading h2 em {
  color: #c99aaa;
  font-style: italic;
}

.treatment-overlay-intro > p {
  max-width: 340px;

  margin: 35px 0 0;

  font-family: 'Albra', serif;
  font-size: 14px;
  line-height: 1.7;

  color: rgba(255,255,255,.48);
}

.overlay-all {
  display: inline-flex;
  align-items: center;
  gap: 12px;

  width: fit-content;

  margin-top: 32px;

  color: #fff;

  font-family: 'Albra', serif;
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;

  text-decoration: none;

  transition: color .3s ease;
}

.overlay-all .arrow {
  width: 17px;
  height: 17px;

  transition:
    transform .45s cubic-bezier(.22,1,.36,1);
}

.overlay-all:hover {
  color: #c99aaa;
}

.overlay-all:hover .arrow {
  transform: translate(3px,-3px);
}


/* =========================================================
   TREATMENT LIST
========================================================= */

.treatment-overlay-list {
  display: grid;

  grid-template-columns: 1fr 1fr;
}

.treatment-group {
  display: grid;

  grid-template-columns: 30px 1fr;

  min-height: 210px;

  padding:
    0
    30px
    30px;

  border-bottom: 1px solid rgba(255,255,255,.12);
}

.treatment-group:nth-child(2n) {
  border-left: 1px solid rgba(255,255,255,.12);
  padding-left: 30px;
}

.treatment-group:nth-child(n+3) {
  padding-top: 30px;
  border-bottom: 0;
}

.treatment-group-number {
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  padding-top: 3px;

  font-family: 'Albra', serif;
  font-size: 8px;
  letter-spacing: .15em;

  color: #c99aaa;
}

.treatment-group-number span:last-child {
  width: 1px;
  height: 40px;

  margin-top: 14px;

  background: rgba(255,255,255,.16);
}

.treatment-group-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 22px;
}

.treatment-group-heading h3 {
  margin: 0;

  font-family: 'Albra', serif;
  font-size: 24px;
  font-weight: 400;
  line-height: 1;

  color: #fff;
}

.treatment-group-heading > span {
  font-family: 'Albra', serif;
  font-size: 8px;
  letter-spacing: .12em;

  color: rgba(255,255,255,.25);
}

.treatment-items {
  display: flex;
  flex-direction: column;
}

.treatment-items a {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 7px 0;

  color: rgba(255,255,255,.43);

  font-family: 'Albra', serif;
  font-size: 11px;

  text-decoration: none;

  transition:
    color .3s ease,
    padding-left .4s cubic-bezier(.22,1,.36,1);
}

.treatment-items a .arrow {
  width: 13px;
  height: 13px;

  opacity: 0;

  transform: translate(-5px,5px);

  transition:
    opacity .3s ease,
    transform .4s cubic-bezier(.22,1,.36,1);
}

.treatment-items a:hover {
  padding-left: 5px;
  color: #fff;
}

.treatment-items a:hover .arrow {
  opacity: 1;
  transform: translate(0,0);
}


/* =========================================================
   MOBILE BUTTON
========================================================= */

.mobile-menu {
  display: none;

  justify-self: end;

  position: relative;

  width: 40px;
  height: 40px;

  padding: 0;

  border: 1px solid rgba(17,17,17,.18);
  border-radius: 50%;

  background: transparent;

  cursor: pointer;
}

.mobile-menu span {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 15px;
  height: 1px;

  background: #111;

  transform: translate(-50%,-50%);

  transition:
    transform .4s cubic-bezier(.22,1,.36,1);
}

.mobile-menu span:last-child {
  transform:
    translate(-50%,-50%)
    translateY(5px);
}

.nav-open .mobile-menu span:first-child {
  transform:
    translate(-50%,-50%)
    rotate(45deg);
}

.nav-open .mobile-menu span:last-child {
  transform:
    translate(-50%,-50%)
    rotate(-45deg);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

  .nav {
    height: 76px;
  }

  .nav-links {
    gap: 18px;
  }

  .nav-links a,
  .nav-treatment-trigger {
    font-size: 9px;
  }

  .treatment-overlay {
    top: 76px;
  }

  .treatment-overlay-inner {
    grid-template-columns: .65fr 1.35fr;
    gap: 45px;
  }

  .overlay-heading h2 {
    font-size: 58px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 750px) {

  .nav {
    height: 70px;

    grid-template-columns: 1fr auto;
  }

  .brand img {
    width: 105px;
  }

  .nav-links,
  .nav-book {
    display: none;
  }

  .mobile-menu {
    display: block;
  }

  .treatment-overlay {
    position: absolute;

    top: 70px;

    max-height: calc(100svh - 70px);

    overflow-y: auto;
  }

  .treatment-overlay-inner {
    display: block;

    padding:
      35px 16px
      50px;
  }

  .overlay-heading {
    margin-top: 30px;
  }

  .overlay-heading h2 {
    font-size: 50px;
  }

  .treatment-overlay-intro > p {
    font-size: 13px;
  }

  .treatment-overlay-list {
    display: flex;
    flex-direction: column;

    margin-top: 50px;
  }

  .treatment-group,
  .treatment-group:nth-child(2n),
  .treatment-group:nth-child(n+3) {
    min-height: auto;

    grid-template-columns: 28px 1fr;

    padding:
      25px 0;

    border-left: 0;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }

  .treatment-group:first-child {
    padding-top: 0;
  }

  .treatment-group:last-child {
    border-bottom: 0;
  }

  .treatment-group-heading h3 {
    font-size: 23px;
  }

  .treatment-items a {
    padding: 9px 0;

    font-size: 12px;
  }

  .treatment-items a .arrow {
    opacity: 1;
    transform: none;
  }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

  .nav {
    height: 64px;

    padding: 0 14px;
  }

  .brand img {
    width: 98px;
  }

  .mobile-menu {
    width: 37px;
    height: 37px;
  }

  .treatment-overlay {
    top: 64px;
  }

  .treatment-overlay-inner {
    padding:
      30px 14px
      40px;
  }

  .overlay-heading h2 {
    font-size: 44px;
  }

  .treatment-overlay-list {
    margin-top: 42px;
  }

  .treatment-group-heading h3 {
    font-size: 21px;
  }
}


